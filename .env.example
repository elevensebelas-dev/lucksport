# ── Konfigurasi Admin (PRD §7.4) ──
# Salin file ini menjadi .env.local lalu ganti nilainya sebelum go-live.

# Password untuk login ke /admin
ADMIN_PASSWORD=lucksport123

# Secret acak untuk menandatangani sesi admin.
# Gunakan string acak panjang, mis. hasil: openssl rand -hex 32
AUTH_SECRET=ganti-dengan-string-acak-panjang

# ── Analytics (Fase 2, opsional) ──
# Kosongkan jika belum dipakai — script tidak akan dimuat.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Ongkir (Fase 3, opsional) ──
# Bila diisi, estimator ongkir siap dihubungkan ke RajaOngkir.
# Tanpa key, dipakai tabel tarif fallback per wilayah.
RAJAONGKIR_API_KEY=

# ── Database (Supabase / PostgreSQL) ──
# Runtime (app): TRANSACTION POOLER Supabase, port 6543 (wajib untuk serverless).
# Kosongkan → app fallback ke data file/SEED lama (read-only).
DATABASE_URL=

# Migrasi/seed (drizzle-kit push, db:seed): koneksi LANGSUNG, port 5432.
DIRECT_URL=

# ── Object storage (Vercel Blob) ──
# Terisi OTOMATIS oleh Vercel saat Blob store dihubungkan ke project.
# Untuk uji upload ke Blob dari lokal, salin token dari dashboard Vercel.
BLOB_READ_WRITE_TOKEN=
